FROM node:20-alpine
WORKDIR /app

# Copia configurações da raiz e da API
COPY package*.json ./
COPY apps/api/package*.json ./apps/api/

# Instala as dependências
RUN npm install

# Copia o código-fonte da API
COPY apps/api/ ./apps/api/

# Compila o TypeScript
WORKDIR /app/apps/api
RUN npm run build

EXPOSE 3001

CMD ["npm", "start"]
